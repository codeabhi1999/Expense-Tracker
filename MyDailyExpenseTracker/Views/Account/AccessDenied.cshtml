@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-6 col-md-8 text-center animate-fade-in">
        <div class="card p-5" style="border-radius: var(--radius-lg); backdrop-filter: var(--glass-blur);">
            <div style="font-size: 72px; color: var(--color-danger); line-height: 1;" class="mb-3">
                <i class="bi bi-shield-x"></i>
            </div>
            <h1 class="h3 fw-800 text-primary-custom mb-2">Access Denied</h1>
            <p class="text-secondary-custom mb-4" style="max-width: 420px; margin: 0 auto; font-size: 15px;">
                You don't have permission to access this resource or page. If you believe this is an error, please reach out to your system administrator.
            </p>
            <div class="d-flex gap-3 justify-content-center">
                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-grid-1x2-fill me-2"></i>Go to Dashboard
                </a>
                <button type="button" onclick="history.back()" class="btn btn-outline-secondary px-4 py-2">
                    <i class="bi bi-arrow-left me-2"></i>Go Back
                </button>
            </div>
        </div>
    </div>
</div>
