@{
    ViewData["Title"] = "Password Reset Sent";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Link Sent | My Daily Expense Tracker</title>
    <script>
        (function() {
            try {
                var saved = localStorage.getItem('mdet-theme');
                if (saved === 'dark' || saved === 'light') {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            } catch (_) {}
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">

    <!-- Atmospheric Mesh Glow & Tech Grid -->
    <div class="mesh-bg-container">
        <div class="mesh-blob mesh-blob-1"></div>
        <div class="mesh-blob mesh-blob-2"></div>
        <div class="mesh-blob mesh-blob-3"></div>
    </div>
    <div class="auth-grid-pattern"></div>
    <div class="auth-ambient-glow"></div>

    <!-- Floating Top Bar -->
    <header class="auth-floating-nav">
        <button id="theme-toggle" class="auth-glass-capsule" type="button" title="Toggle visual theme" aria-label="Toggle visual theme">
            <i id="theme-icon" class="bi bi-moon-fill"></i>
            <span id="theme-text" class="d-none d-sm-inline">Theme</span>
        </button>
    </header>

    <!-- Main Auth Container -->
    <main class="auth-container">
        <div class="auth-card animate-fade-in text-center">
            <div class="auth-logo">
                <div class="logo-wrapper">
                    <div class="logo-glow"></div>
                    <div class="logo-icon" style="background: linear-gradient(135deg, #10B981, #059669);">
                        <i class="bi bi-envelope-check"></i>
                    </div>
                </div>

                <div>
                    <span class="auth-pill-badge" style="background:rgba(16,185,129,0.12);border-color:rgba(16,185,129,0.3);color:#10B981;">
                        <span class="badge-dot" style="background:#10B981;box-shadow:0 0 8px #10B981;"></span>
                        Email Dispatched
                    </span>
                </div>

                <h1 class="auth-title">Check Your Email</h1>
                <p class="auth-subtitle mb-4">If that email exists in our records, a secure password reset link has been dispatched to your inbox.</p>
            </div>

            @if (TempData["ResetLink"] != null)
            {
                <div class="alert alert-info text-start mb-4" style="border-radius:14px;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.25);color:var(--text-primary);font-size:12.5px;word-break:break-all;">
                    <div class="fw-bold mb-1 text-primary"><i class="bi bi-code-slash me-1"></i> Development Reset Link:</div>
                    <a href="@TempData["ResetLink"]" class="text-break" style="color:#60A5FA;">@TempData["ResetLink"]</a>
                </div>
            }

            <a href="@Url.Action("Login")" class="auth-submit-btn text-decoration-none">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Sign In</span>
            </a>

            <div class="auth-trust-badge">
                <i class="bi bi-shield-check"></i>
                <span>Bank-grade 256-bit encryption • Private & secure</span>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function updateThemePillLabel() {
            const themeText = document.getElementById('theme-text');
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
            if (themeText) {
                themeText.textContent = currentTheme === 'dark' ? 'Night' : 'Day';
            }
        }
        document.getElementById('theme-toggle')?.addEventListener('click', function() {
            setTimeout(updateThemePillLabel, 50);
        });
        updateThemePillLabel();
    </script>
</body>
</html>
