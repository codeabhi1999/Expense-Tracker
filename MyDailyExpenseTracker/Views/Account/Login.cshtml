@model MyDailyExpenseTracker.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In | My Daily Expense Tracker</title>
    <script>
        (function() {
            try {
                var saved = localStorage.getItem('mdet-theme');
                if (saved === 'dark' || saved === 'light') {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            } catch (_) {}
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">

    <!-- Atmospheric Mesh Glow & Tech Grid -->
    <div class="mesh-bg-container">
        <div class="mesh-blob mesh-blob-1"></div>
        <div class="mesh-blob mesh-blob-2"></div>
        <div class="mesh-blob mesh-blob-3"></div>
    </div>
    <div class="auth-grid-pattern"></div>
    <div class="auth-ambient-glow"></div>

    <!-- Floating Top Bar -->
    <header class="auth-floating-nav">
        <button id="theme-toggle" class="auth-glass-capsule" type="button" title="Toggle visual theme" aria-label="Toggle visual theme">
            <i id="theme-icon" class="bi bi-moon-fill"></i>
            <span id="theme-text" class="d-none d-sm-inline">Theme</span>
        </button>
    </header>

    <!-- Main Auth Container -->
    <main class="auth-container">
        <div class="auth-card animate-fade-in">
            <!-- Brand Logo & Header -->
            <div class="auth-logo">
                <div class="logo-wrapper">
                    <div class="logo-glow"></div>
                    <div class="logo-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>

                <div>
                    <span class="auth-pill-badge">
                        <span class="badge-dot"></span>
                        Smart Finance Tracker
                    </span>
                </div>

                <h1 class="auth-title">Welcome Back</h1>
                <p class="auth-subtitle">Sign in to manage your budgets, cashflows & expenses</p>
            </div>

            <!-- Server-Side Notifications -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius:14px;background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);color:#F87171;">
                    <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                    <div asp-validation-summary="ModelOnly" class="small mb-0"></div>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius:14px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.3);color:#34D399;">
                    <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
                    <div class="small mb-0">@TempData["Success"]</div>
                </div>
            }

            <!-- Quick Demo Helper Chip -->
            <div class="auth-demo-bar">
                <button type="button" class="auth-demo-pill" id="demo-fill-btn" title="1-click fill test credentials">
                    <i class="bi bi-magic"></i>
                    <span>Quick Fill Demo</span>
                </button>
            </div>

            <!-- Sign In Form -->
            <form asp-action="Login" method="post" id="login-form" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@ViewBag.ReturnUrl" />

                <!-- Email Input -->
                <div class="auth-field-group">
                    <label asp-for="Email" class="auth-label">Email Address</label>
                    <div class="auth-input-wrapper" id="email-input-wrapper">
                        <span class="auth-input-icon"><i class="bi bi-envelope-fill"></i></span>
                        <input asp-for="Email" type="email" class="auth-input"
                               placeholder="name@example.com" autocomplete="email" id="login-email" required />
                    </div>
                    <span asp-validation-for="Email" class="auth-field-error"></span>
                </div>

                <!-- Password Input -->
                <div class="auth-field-group">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="auth-label mb-0">Password</label>
                        <a href="@Url.Action("ForgotPassword")" class="auth-forgot-link">Forgot password?</a>
                    </div>
                    <div class="auth-input-wrapper" id="password-input-wrapper">
                        <span class="auth-input-icon"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="Password" type="password" class="auth-input"
                               placeholder="Enter your password" autocomplete="current-password" id="login-password" required />
                        <button type="button" class="auth-toggle-password" onclick="togglePw('login-password', this)" title="Show or hide password" aria-label="Toggle password visibility">
                            <i class="bi bi-eye-fill"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="auth-field-error"></span>
                </div>

                <!-- Remember Me Checkbox -->
                <div class="d-flex align-items-center justify-content-between my-3">
                    <label class="auth-checkbox-container" for="remember-me">
                        <input asp-for="RememberMe" class="auth-checkbox-input" type="checkbox" id="remember-me" />
                        <span class="auth-custom-checkbox">
                            <i class="bi bi-check-lg"></i>
                        </span>
                        <span class="auth-checkbox-label">Remember me for 14 days</span>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-submit-btn" id="login-btn">
                    <span id="btn-text">Sign In</span>
                    <i class="bi bi-arrow-right" id="btn-icon"></i>
                </button>
            </form>

            <!-- Bottom Registration Link -->
            <div class="auth-footer-nav">
                Don't have an account yet?
                <a href="@Url.Action("Register")">Create one free</a>
            </div>

            <!-- Security Trust Badge -->
            <div class="auth-trust-badge">
                <i class="bi bi-shield-check"></i>
                <span>Bank-grade 256-bit encryption • Private & secure</span>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Password Visibility Toggle
        function togglePw(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector('i');
            if (!input) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash-fill';
                btn.setAttribute('aria-label', 'Hide password');
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye-fill';
                btn.setAttribute('aria-label', 'Show password');
            }
        }

        // Quick Demo Fill Helper
        document.getElementById('demo-fill-btn')?.addEventListener('click', function() {
            const emailInput = document.getElementById('login-email');
            const pwInput = document.getElementById('login-password');
            const emailWrapper = document.getElementById('email-input-wrapper');
            const pwWrapper = document.getElementById('password-input-wrapper');

            if (emailInput && pwInput) {
                // If the user already had their email, keep it or fill test credentials
                emailInput.value = 'chavanabhijeet95@gmail.com';
                pwInput.value = 'Password123!';

                // Visual flash feedback
                [emailWrapper, pwWrapper].forEach(w => {
                    if (w) {
                        w.style.borderColor = '#10B981';
                        w.style.boxShadow = '0 0 0 4px rgba(16, 185, 129, 0.2)';
                        setTimeout(() => {
                            w.style.borderColor = '';
                            w.style.boxShadow = '';
                        }, 1200);
                    }
                });
            }
        });

        // Form Submit Loading Feedback
        document.getElementById('login-form')?.addEventListener('submit', function() {
            const btn = document.getElementById('login-btn');
            const btnText = document.getElementById('btn-text');
            const btnIcon = document.getElementById('btn-icon');

            if (btn && btnText && btnIcon) {
                btn.style.pointerEvents = 'none';
                btn.style.opacity = '0.85';
                btnIcon.className = 'spinner-border spinner-border-sm';
                btnText.textContent = 'Signing in...';
            }
        });

        // Sync theme pill label with current theme
        function updateThemePillLabel() {
            const themeText = document.getElementById('theme-text');
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
            if (themeText) {
                themeText.textContent = currentTheme === 'dark' ? 'Night' : 'Day';
            }
        }

        document.getElementById('theme-toggle')?.addEventListener('click', function() {
            setTimeout(updateThemePillLabel, 50);
        });
        updateThemePillLabel();
    </script>
</body>
</html>
