@model MyDailyExpenseTracker.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;  // Auth pages have no sidebar
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | My Daily Expense Tracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="auth-container">
    <div class="auth-card animate-fade-in">
        <div class="auth-logo">
            <div class="logo-icon"><i class="bi bi-wallet2"></i></div>
            <h1 class="auth-title">Welcome Back</h1>
            <p class="auth-subtitle">Sign in to your expense tracker</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger mb-4">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4">@TempData["Success"]</div>
        }

        <form asp-action="Login" method="post" id="login-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@ViewBag.ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" type="email" class="form-control"
                           placeholder="you@example.com" autocomplete="email" id="login-email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <label asp-for="Password" class="form-label">Password</label>
                    <a href="@Url.Action("ForgotPassword")" class="text-muted" style="font-size:12px">Forgot password?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" type="password" class="form-control"
                           placeholder="Your password" autocomplete="current-password" id="login-password" />
                    <button type="button" class="input-group-text" onclick="togglePw('login-password',this)" style="cursor:pointer">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="remember-me" />
                    <label class="form-check-label" for="remember-me" style="font-size:13px">Remember me for 14 days</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 mb-3" id="login-btn">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>
        </form>

        <div class="text-center" style="font-size:13px;color:var(--text-muted)">
            Don't have an account?
            <a href="@Url.Action("Register")" class="fw-600" style="color:var(--accent-primary)">Create one free</a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
function togglePw(id, btn) {
    const input = document.getElementById(id);
    const icon  = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
    }
}
</script>
</body>
</html>
