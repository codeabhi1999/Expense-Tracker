@model MyDailyExpenseTracker.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set New Password | My Daily Expense Tracker</title>
    <script>
        (function() {
            try {
                var saved = localStorage.getItem('mdet-theme');
                if (saved === 'dark' || saved === 'light') {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            } catch (_) {}
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">

    <!-- Atmospheric Mesh Glow & Tech Grid -->
    <div class="mesh-bg-container">
        <div class="mesh-blob mesh-blob-1"></div>
        <div class="mesh-blob mesh-blob-2"></div>
        <div class="mesh-blob mesh-blob-3"></div>
    </div>
    <div class="auth-grid-pattern"></div>
    <div class="auth-ambient-glow"></div>

    <!-- Floating Top Bar -->
    <header class="auth-floating-nav">
        <button id="theme-toggle" class="auth-glass-capsule" type="button" title="Toggle visual theme" aria-label="Toggle visual theme">
            <i id="theme-icon" class="bi bi-moon-fill"></i>
            <span id="theme-text" class="d-none d-sm-inline">Theme</span>
        </button>
    </header>

    <!-- Main Auth Container -->
    <main class="auth-container">
        <div class="auth-card animate-fade-in">
            <!-- Brand Logo & Header -->
            <div class="auth-logo">
                <div class="logo-wrapper">
                    <div class="logo-glow"></div>
                    <div class="logo-icon">
                        <i class="bi bi-key-fill"></i>
                    </div>
                </div>

                <div>
                    <span class="auth-pill-badge">
                        <span class="badge-dot"></span>
                        Security Update
                    </span>
                </div>

                <h1 class="auth-title">Set New Password</h1>
                <p class="auth-subtitle">Create a strong password with at least 8 characters</p>
            </div>

            <!-- Server-Side Notifications -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius:14px;background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);color:#F87171;">
                    <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                    <div asp-validation-summary="ModelOnly" class="small mb-0"></div>
                </div>
            }

            <form asp-action="ResetPassword" method="post" id="reset-form" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <!-- New Password -->
                <div class="auth-field-group mb-3">
                    <label asp-for="NewPassword" class="auth-label">New Password</label>
                    <div class="auth-input-wrapper">
                        <span class="auth-input-icon"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="NewPassword" type="password" class="auth-input"
                               placeholder="Min. 8 characters" autocomplete="new-password" id="new-pw" required />
                        <button type="button" class="auth-toggle-password" onclick="togglePw('new-pw', this)" title="Show/Hide password" aria-label="Toggle password visibility">
                            <i class="bi bi-eye-fill"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="auth-field-error"></span>
                </div>

                <!-- Confirm Password -->
                <div class="auth-field-group mb-4">
                    <label asp-for="ConfirmPassword" class="auth-label">Confirm New Password</label>
                    <div class="auth-input-wrapper">
                        <span class="auth-input-icon"><i class="bi bi-shield-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="auth-input"
                               placeholder="Repeat new password" autocomplete="new-password" id="conf-pw" required />
                        <button type="button" class="auth-toggle-password" onclick="togglePw('conf-pw', this)" title="Show/Hide password" aria-label="Toggle password visibility">
                            <i class="bi bi-eye-fill"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
                </div>

                <button type="submit" class="auth-submit-btn" id="reset-btn">
                    <span id="reset-btn-text">Update Password</span>
                    <i class="bi bi-check-circle-fill" id="reset-btn-icon"></i>
                </button>
            </form>

            <div class="auth-footer-nav">
                <a href="@Url.Action("Login")"><i class="bi bi-arrow-left me-1"></i>Back to Sign In</a>
            </div>

            <div class="auth-trust-badge">
                <i class="bi bi-shield-check"></i>
                <span>Bank-grade 256-bit encryption • Private & secure</span>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function togglePw(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector('i');
            if (!input) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash-fill';
                btn.setAttribute('aria-label', 'Hide password');
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye-fill';
                btn.setAttribute('aria-label', 'Show password');
            }
        }

        document.getElementById('reset-form')?.addEventListener('submit', function() {
            const btn = document.getElementById('reset-btn');
            const btnText = document.getElementById('reset-btn-text');
            const btnIcon = document.getElementById('reset-btn-icon');

            if (btn && btnText && btnIcon) {
                btn.style.pointerEvents = 'none';
                btn.style.opacity = '0.85';
                btnIcon.className = 'spinner-border spinner-border-sm';
                btnText.textContent = 'Updating password...';
            }
        });

        function updateThemePillLabel() {
            const themeText = document.getElementById('theme-text');
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
            if (themeText) {
                themeText.textContent = currentTheme === 'dark' ? 'Night' : 'Day';
            }
        }

        document.getElementById('theme-toggle')?.addEventListener('click', function() {
            setTimeout(updateThemePillLabel, 50);
        });
        updateThemePillLabel();
    </script>
</body>
</html>
