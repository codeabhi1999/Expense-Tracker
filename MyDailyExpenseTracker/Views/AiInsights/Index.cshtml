@model MyDailyExpenseTracker.ViewModels.AiInsightsViewModel
@{
    ViewData["Title"] = "AI Studio";
    ViewData["PageTitle"] = "AI Financial Studio";

    string FormatAmount(decimal amount) => amount.ToString("N2");
}

<div class="page-header d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="page-title m-0">AI Financial Studio</h1>
            <span class="badge-ai">AI 2.0 ✨</span>
        </div>
        <p class="text-muted-custom m-0" style="font-size:14px;">
            Real-time financial intelligence, predictive burn rates, and automated spending diagnostics.
        </p>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2"
                onclick="window.location.reload()" style="border-radius:var(--radius-sm);">
            <i class="bi bi-arrow-clockwise"></i> Refresh Analytics
        </button>
        <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-2"
                onclick="openAiChat()" style="background:var(--accent-ai);border:none;border-radius:var(--radius-sm);font-weight:600;">
            <i class="bi bi-chat-dots-fill"></i> Ask Copilot
        </button>
    </div>
</div>

<!-- ── Top Overview: Health Diagnostics & Forecast ── -->
<div class="row g-4 mb-4">
    <!-- Financial Health Score Deep Dive -->
    <div class="col-lg-5">
        <div class="health-score-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-700 text-primary-custom fs-6 d-flex align-items-center gap-2">
                    <i class="bi bi-heart-pulse-fill text-danger"></i> Financial Health Diagnostic
                </span>
                <span class="badge" style="background:rgba(168,85,247,0.15);color:#A855F7;border:1px solid rgba(168,85,247,0.3);font-size:12px;padding:5px 10px;">
                    Grade @Model.HealthScore.Grade • @Model.HealthScore.StatusBadge
                </span>
            </div>

            <div class="d-flex align-items-center gap-4 my-3 flex-wrap">
                <div class="health-gauge-wrap" style="margin:0;">
                    <svg class="health-gauge-svg" viewBox="0 0 140 140">
                        <defs>
                            <linearGradient id="aiStudioGauge" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#6366F1" />
                                <stop offset="50%" stop-color="#A855F7" />
                                <stop offset="100%" stop-color="#EC4899" />
                            </linearGradient>
                        </defs>
                        <circle class="health-gauge-bg" cx="70" cy="70" r="56"></circle>
                        @{
                            double circ = 2 * Math.PI * 56;
                            double offset = circ - (circ * Math.Clamp(Model.HealthScore.Score, 5, 100) / 100.0);
                        }
                        <circle class="health-gauge-bar" cx="70" cy="70" r="56"
                                stroke-dasharray="@circ"
                                stroke-dashoffset="@offset"></circle>
                    </svg>
                    <div class="health-gauge-content">
                        <div class="health-score-number">@Model.HealthScore.Score</div>
                        <small class="text-muted-custom" style="font-size:11px;">out of 100</small>
                    </div>
                </div>

                <div style="flex:1;min-width:180px;">
                    <h5 class="fw-700 text-primary-custom mb-1">@Model.HealthScore.Title</h5>
                    <p class="text-muted-custom mb-0" style="font-size:13px;line-height:1.5;">
                        @Model.HealthScore.Summary
                    </p>
                </div>
            </div>

            <!-- 5 Pillars -->
            <div class="pillar-group pt-3 border-top border-subtle-custom">
                <div class="pillar-row">
                    <div class="pillar-header">
                        <span>Savings Discipline (Income retained)</span>
                        <strong class="text-primary-custom">@Model.HealthScore.SavingsRatioScore%</strong>
                    </div>
                    <div class="pillar-track">
                        <div class="pillar-fill" style="width:@Model.HealthScore.SavingsRatioScore%;"></div>
                    </div>
                </div>
                <div class="pillar-row">
                    <div class="pillar-header">
                        <span>Budget Adherence (Velocity vs limit)</span>
                        <strong class="text-primary-custom">@Model.HealthScore.BudgetDisciplineScore%</strong>
                    </div>
                    <div class="pillar-track">
                        <div class="pillar-fill" style="width:@Model.HealthScore.BudgetDisciplineScore%;"></div>
                    </div>
                </div>
                <div class="pillar-row">
                    <div class="pillar-header">
                        <span>Spending Stability (Consistency)</span>
                        <strong class="text-primary-custom">@Model.HealthScore.SpendingStabilityScore%</strong>
                    </div>
                    <div class="pillar-track">
                        <div class="pillar-fill" style="width:@Model.HealthScore.SpendingStabilityScore%;"></div>
                    </div>
                </div>
                <div class="pillar-row">
                    <div class="pillar-header">
                        <span>Discretionary Control (Non-essentials)</span>
                        <strong class="text-primary-custom">@Model.HealthScore.EssentialBurdenScore%</strong>
                    </div>
                    <div class="pillar-track">
                        <div class="pillar-fill" style="width:@Model.HealthScore.EssentialBurdenScore%;"></div>
                    </div>
                </div>
                <div class="pillar-row mb-0">
                    <div class="pillar-header">
                        <span>Category Diversification</span>
                        <strong class="text-primary-custom">@Model.HealthScore.CategoryBalanceScore%</strong>
                    </div>
                    <div class="pillar-track">
                        <div class="pillar-fill" style="width:@Model.HealthScore.CategoryBalanceScore%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Spending Anomaly & Surge Alerts -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="card-title d-flex align-items-center gap-2">
                    <i class="bi bi-shield-exclamation text-warning"></i> AI Anomaly & Surge Detector
                </span>
                <span class="badge" style="background:var(--bg-card-hover);color:var(--text-secondary);border:1px solid var(--border-color);">
                    @Model.Anomalies.Count Active Signal@(Model.Anomalies.Count == 1 ? "" : "s")
                </span>
            </div>
            <div class="card-body">
                @if (Model.Anomalies.Any())
                {
                    foreach (var anomaly in Model.Anomalies)
                    {
                        <div class="anomaly-card @anomaly.Severity">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="stat-icon" style="width:34px;height:34px;font-size:15px;">
                                        <i class="bi @anomaly.CategoryIcon"></i>
                                    </div>
                                    <div>
                                        <strong class="text-primary-custom" style="font-size:14px;">@anomaly.Title</strong>
                                        <span class="badge ms-2 @(anomaly.Severity == "danger" ? "bg-danger" : "bg-warning text-dark")" style="font-size:10px;">
                                            +@anomaly.PercentageDiff% Surge
                                        </span>
                                    </div>
                                </div>
                                <strong class="text-primary-custom">₹@FormatAmount(anomaly.Amount)</strong>
                            </div>
                            <p class="text-secondary-custom mb-2" style="font-size:13px;line-height:1.4;">
                                @anomaly.Description
                            </p>
                            <div class="d-flex align-items-center gap-2 p-2 rounded-2" style="background:rgba(255,255,255,0.03);font-size:12px;">
                                <i class="bi bi-lightbulb-fill text-warning"></i>
                                <span class="text-muted-custom"><strong>Action:</strong> @anomaly.RecommendedAction</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <div class="stat-icon mx-auto mb-2 text-success" style="background:rgba(0,230,118,0.12);width:48px;height:48px;font-size:22px;">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <h6 class="text-primary-custom fw-700">All Spending Patterns Normal</h6>
                        <p class="text-muted-custom mb-0" style="font-size:13px;">
                            No unusual surges or category spikes detected compared to baseline averages.
                        </p>
                    </div>
                }

                <!-- Burn Rate Mini Banner -->
                <div class="p-3 rounded-3 mt-3 border border-subtle-custom" style="background:var(--bg-card-hover);">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <span class="text-muted-custom" style="font-size:12px;">Daily Velocity:</span>
                            <strong class="text-primary-custom ms-1">₹@FormatAmount(Model.Forecast.DailyBurnRate)/day</strong>
                        </div>
                        <div>
                            <span class="text-muted-custom" style="font-size:12px;">Safe Cap:</span>
                            <strong class="text-success ms-1">₹@FormatAmount(Model.Forecast.SafeDailyBudget)/day</strong>
                        </div>
                        <div>
                            <span class="text-muted-custom" style="font-size:12px;">Days Remaining:</span>
                            <strong class="text-primary-custom ms-1">@Model.Forecast.DaysRemaining</strong>
                        </div>
                        <div>
                            <span class="burn-pace-pill @(Model.Forecast.PaceStatus.ToLower() switch { "critical" => "critical", "accelerating" => "accelerating", _ => "ontrack" })">
                                <i class="bi bi-record-fill" style="font-size:8px;"></i> @Model.Forecast.PaceStatus
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Middle Row: Full AI Copilot Console & Category Velocity ── -->
<div class="row g-4 mb-4">
    <!-- Interactive Copilot Chat Box -->
    <div class="col-lg-7">
        <div class="card h-100" style="border:var(--ai-border);box-shadow:var(--ai-glow), var(--shadow-card);">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="card-title d-flex align-items-center gap-2">
                    <i class="bi bi-stars text-primary"></i> Financial Copilot Console
                </span>
                <span class="badge" style="background:rgba(168,85,247,0.15);color:#A855F7;">
                    Instant Q&A
                </span>
            </div>
            <div class="card-body d-flex flex-column" style="height:440px;">
                <div class="ai-drawer-body flex-grow-1 p-0 mb-3" id="ai-studio-chat-messages" style="overflow-y:auto;">
                    <div class="chat-msg ai">
                        <div class="chat-avatar ai"><i class="bi bi-stars"></i></div>
                        <div class="chat-bubble">
                            Welcome to your **AI Financial Studio**. I can analyze your transaction ledger, highlight hidden waste, simulate savings goals, and forecast your end-of-month cash position.<br/><br/>
                            Ask me anything below or select a quick query:
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 pt-2">
                        <button type="button" class="ai-prompt-chip" data-prompt="Where did I spend the most this month?">
                            <i class="bi bi-pie-chart"></i> Top spending category
                        </button>
                        <button type="button" class="ai-prompt-chip" data-prompt="How can I save ₹3,000 more this month?">
                            <i class="bi bi-piggy-bank"></i> How to save ₹3,000
                        </button>
                        <button type="button" class="ai-prompt-chip" data-prompt="Will I exceed my monthly budget?">
                            <i class="bi bi-speedometer2"></i> Budget burn velocity
                        </button>
                        <button type="button" class="ai-prompt-chip" data-prompt="Show my weekend vs weekday spending">
                            <i class="bi bi-calendar2-week"></i> Weekend vs Weekdays
                        </button>
                    </div>
                </div>

                <div class="pt-3 border-top border-subtle-custom">
                    <div class="d-flex gap-2">
                        <input type="text" id="ai-studio-chat-input" class="form-control"
                               placeholder="Ask AI Copilot about your expenses, budgets, or savings tips..."
                               style="background:var(--bg-input);border-color:var(--border-dropdown);color:var(--text-primary);border-radius:var(--radius-sm);" />
                        <button type="button" id="ai-studio-chat-send-btn" class="btn btn-primary px-4"
                                style="background:var(--accent-ai);border:none;border-radius:var(--radius-sm);font-weight:600;">
                            <i class="bi bi-send-fill me-1"></i> Ask
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Spending Velocity & Month-over-Month -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="card-title d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left-right text-info"></i> Category Velocity
                </h2>
            </div>
            <div class="card-body p-0">
                @if (Model.CategoryTrends.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var cat in Model.CategoryTrends)
                        {
                            <div class="list-group-item d-flex align-items-center justify-content-between p-3"
                                 style="background:transparent;border-color:var(--border-subtle);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="stat-icon" style="width:36px;height:36px;background:@(cat.CategoryColor)20;color:@cat.CategoryColor;font-size:16px;">
                                        <i class="bi @cat.CategoryIcon"></i>
                                    </div>
                                    <div>
                                        <strong class="text-primary-custom d-block" style="font-size:14px;">@cat.CategoryName</strong>
                                        <small class="text-muted-custom">Last Month: ₹@FormatAmount(cat.PreviousMonthAmount)</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <strong class="text-primary-custom d-block">₹@FormatAmount(cat.CurrentMonthAmount)</strong>
                                    @if (cat.PreviousMonthAmount > 0)
                                    {
                                        <small class="@(cat.IsHigher ? "text-danger" : "text-success") fw-600">
                                            @(cat.IsHigher ? "↑" : "↓") @Math.Abs(cat.GrowthPercentage)%
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted-custom">New</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted-custom">
                        <i class="bi bi-pie-chart fs-3 d-block mb-2"></i>
                        No category data recorded yet.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ── Bottom Row: AI Strategic Recommendations ── -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title d-flex align-items-center gap-2">
                    <i class="bi bi-lightbulb-fill text-warning"></i> AI Action Recommendations
                </h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var sug in Model.Suggestions)
                    {
                        <div class="col-md-4">
                            <div class="p-3 rounded-3 h-100 border border-subtle-custom d-flex flex-column justify-content-between" style="background:var(--bg-card-hover);">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="stat-icon" style="width:36px;height:36px;font-size:16px;">
                                            <i class="bi @sug.Icon"></i>
                                        </div>
                                        <span class="badge" style="background:rgba(99,102,241,0.15);color:var(--accent-primary);font-size:11px;">
                                            @sug.ImpactBadge
                                        </span>
                                    </div>
                                    <h6 class="fw-700 text-primary-custom mb-1">@sug.Title</h6>
                                    <p class="text-secondary-custom mb-3" style="font-size:13px;line-height:1.4;">
                                        @sug.Description
                                    </p>
                                </div>
                                @if (!string.IsNullOrEmpty(sug.ActionUrl))
                                {
                                    <a href="@sug.ActionUrl" class="btn btn-outline-primary btn-sm w-100 mt-auto" style="border-radius:var(--radius-sm);font-weight:600;">
                                        Apply Action <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const studioInput = document.getElementById('ai-studio-chat-input');
        const studioSendBtn = document.getElementById('ai-studio-chat-send-btn');
        const studioMessages = document.getElementById('ai-studio-chat-messages');

        function sendStudioMessage(text) {
            if (!text || !studioMessages) return;

            const userDiv = document.createElement('div');
            userDiv.className = 'chat-msg user mb-3';
            userDiv.innerHTML = `
                <div class="chat-avatar user"><i class="bi bi-person"></i></div>
                <div class="chat-bubble">${escapeHtml(text)}</div>
            `;
            studioMessages.appendChild(userDiv);
            if (studioInput) studioInput.value = '';

            const typingDiv = document.createElement('div');
            typingDiv.className = 'chat-msg ai mb-3';
            typingDiv.innerHTML = `
                <div class="chat-avatar ai"><i class="bi bi-stars"></i></div>
                <div class="chat-bubble">
                    <div class="typing-indicator">
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                    </div>
                </div>
            `;
            studioMessages.appendChild(typingDiv);
            studioMessages.scrollTop = studioMessages.scrollHeight;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch('/AiInsights/Ask', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ message: text })
            })
            .then(res => res.json())
            .then(data => {
                typingDiv.remove();
                const aiDiv = document.createElement('div');
                aiDiv.className = 'chat-msg ai mb-3';
                aiDiv.innerHTML = `
                    <div class="chat-avatar ai"><i class="bi bi-stars"></i></div>
                    <div class="chat-bubble">
                        ${formatMarkdown(data.answer)}
                    </div>
                `;
                studioMessages.appendChild(aiDiv);
                studioMessages.scrollTop = studioMessages.scrollHeight;
            })
            .catch(err => {
                typingDiv.remove();
                console.error(err);
            });
        }

        if (studioSendBtn) {
            studioSendBtn.addEventListener('click', () => {
                const val = studioInput?.value?.trim();
                if (val) sendStudioMessage(val);
            });
        }

        if (studioInput) {
            studioInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const val = studioInput.value.trim();
                    if (val) sendStudioMessage(val);
                }
            });
        }

        document.querySelectorAll('#ai-studio-chat-messages .ai-prompt-chip').forEach(chip => {
            chip.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const q = chip.getAttribute('data-prompt') || chip.innerText.trim();
                sendStudioMessage(q);
            });
        });

        function formatMarkdown(text) {
            if (!text) return '';
            let html = escapeHtml(text);
            html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
            html = html.replace(/\n•\s*(.*?)(?=\n|$)/g, '<div class="ms-2 mb-1">• $1</div>');
            html = html.replace(/\n\n/g, '<br/><br/>').replace(/\n/g, '<br/>');
            return html;
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    });
</script>
}
