@model MyDailyExpenseTracker.ViewModels.BudgetViewModel
@{
    ViewData["Title"]     = "Monthly Budget";
    ViewData["PageTitle"] = "Monthly Budget Architecture";
    var monthDate = new DateTime(Model.Year, Model.Month, 1);
    var monthName = monthDate.ToString("MMMM yyyy");

    // Dynamic Financial Calculations
    var daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
    var isCurrentMonth = (Model.Year == DateTime.Now.Year && Model.Month == DateTime.Now.Month);
    var daysRemaining = isCurrentMonth ? Math.Max(1, daysInMonth - DateTime.Now.Day + 1) : daysInMonth;
    var safeDailySpend = Model.RemainingBudget > 0 ? (Model.RemainingBudget / daysRemaining) : 0;

    var prevMonth = Model.Month == 1 ? 12 : Model.Month - 1;
    var prevYear  = Model.Month == 1 ? Model.Year - 1 : Model.Year;
    var nextMonth = Model.Month == 12 ? 1 : Model.Month + 1;
    var nextYear  = Model.Month == 12 ? Model.Year + 1 : Model.Year;
}

<!-- ── Executive Hero Header ── -->
<div class="budget-hero-header animate-fade-in">
    <div class="budget-hero-title">
        <div class="budget-hero-icon">
            <i class="bi bi-pie-chart-fill"></i>
        </div>
        <div>
            <h1>Budget Blueprint — @monthName</h1>
            <p>Strategic capital allocation & real-time daily burn rate analytics</p>
        </div>
    </div>

    <!-- Quick Month Navigator -->
    <div class="budget-nav-cluster">
        <div class="budget-quick-jump">
            <a href="@Url.Action("Index", "Budget", new { month = prevMonth, year = prevYear })" title="Previous Month">
                <i class="bi bi-chevron-left"></i> Prev
            </a>
            <a href="@Url.Action("Index", "Budget", new { month = DateTime.Now.Month, year = DateTime.Now.Year })"
               class="@(isCurrentMonth ? "active" : "")">
                Current
            </a>
            <a href="@Url.Action("Index", "Budget", new { month = nextMonth, year = nextYear })" title="Next Month">
                Next <i class="bi bi-chevron-right"></i>
            </a>
        </div>

        <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
            <select name="month" class="form-select form-select-sm" style="width:130px; border-radius: 20px;">
                @foreach (var m in Model.Months)
                {
                    if (m.Selected) { <option value="@m.Value" selected>@m.Text</option> }
                    else            { <option value="@m.Value">@m.Text</option> }
                }
            </select>
            <select name="year" class="form-select form-select-sm" style="width:95px; border-radius: 20px;">
                @foreach (var y in Model.Years)
                {
                    if (y.Selected) { <option value="@y.Value" selected>@y.Text</option> }
                    else            { <option value="@y.Value">@y.Text</option> }
                }
            </select>
            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </form>
    </div>
</div>

<!-- ── Executive KPI Grid ── -->
<div class="budget-kpi-grid animate-fade-in">
    <div class="budget-kpi-card kpi-total">
        <div class="budget-kpi-header">
            <span class="budget-kpi-label">Monthly Ceiling</span>
            <span class="budget-kpi-icon"><i class="bi bi-shield-check"></i></span>
        </div>
        <div class="budget-kpi-value text-primary">₹@Model.TotalBudget.ToString("N2")</div>
        <div class="budget-kpi-footer">
            <i class="bi bi-calendar3"></i> Target for @monthDate.ToString("MMMM")
        </div>
    </div>

    <div class="budget-kpi-card kpi-spent">
        <div class="budget-kpi-header">
            <span class="budget-kpi-label">Capital Burned</span>
            <span class="budget-kpi-icon"><i class="bi bi-fire"></i></span>
        </div>
        <div class="budget-kpi-value text-expense">₹@Model.TotalSpent.ToString("N2")</div>
        <div class="budget-kpi-footer">
            <i class="bi bi-percent"></i> <strong>@Model.UsedPercentage%</strong> utilized
        </div>
    </div>

    <div class="budget-kpi-card kpi-remaining">
        <div class="budget-kpi-header">
            <span class="budget-kpi-label">Remaining Runway</span>
            <span class="budget-kpi-icon"><i class="bi bi-wallet2"></i></span>
        </div>
        <div class="budget-kpi-value @(Model.RemainingBudget >= 0 ? "text-income" : "text-expense")">
            ₹@Model.RemainingBudget.ToString("N2")
        </div>
        <div class="budget-kpi-footer">
            @(Model.RemainingBudget >= 0 ? "Safe Capital Available" : "🚨 Over-budget by ₹" + Math.Abs(Model.RemainingBudget).ToString("N2"))
        </div>
    </div>

    <div class="budget-kpi-card kpi-daily">
        <div class="budget-kpi-header">
            <span class="budget-kpi-label">Safe Daily Velocity</span>
            <span class="budget-kpi-icon"><i class="bi bi-speedometer2"></i></span>
        </div>
        <div class="budget-kpi-value text-balance">
            ₹@safeDailySpend.ToString("N0")<span style="font-size:14px; font-weight:600; color:var(--text-muted)">/day</span>
        </div>
        <div class="budget-kpi-footer">
            <i class="bi bi-hourglass-split"></i> @daysRemaining day@(daysRemaining > 1 ? "s" : "") left in cycle
        </div>
    </div>
</div>

<!-- ── Live Progress Glow Bar ── -->
@if (Model.TotalBudget > 0)
{
    var progressStatus = Model.IsExceeded ? "exceeded" : Model.IsWarning ? "warning" : "healthy";
    <div class="budget-progress-dock animate-fade-in">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center gap-2">
                @if (Model.IsExceeded)
                {
                    <span class="cat-pill-badge exceeded"><i class="bi bi-exclamation-octagon-fill"></i> CRITICAL EXCEEDED</span>
                    <strong style="font-size:13.5px; color:var(--color-danger)">Budget exceeded by ₹@Math.Abs(Model.RemainingBudget).ToString("N2")!</strong>
                }
                else if (Model.IsWarning)
                {
                    <span class="cat-pill-badge warning"><i class="bi bi-exclamation-triangle-fill"></i> WARNING THRESHOLD</span>
                    <strong style="font-size:13.5px; color:var(--color-warning)">You have used @Model.UsedPercentage% of your monthly allocation.</strong>
                }
                else
                {
                    <span class="cat-pill-badge healthy"><i class="bi bi-check-circle-fill"></i> OPTIMAL PACE</span>
                    <strong style="font-size:13.5px; color:var(--color-success)">Healthy pacing! ₹@Model.RemainingBudget.ToString("N2") remaining.</strong>
                }
            </div>
            <span class="fw-800" style="font-size:15px; font-family:'IBM Plex Mono', monospace;">@Model.UsedPercentage%</span>
        </div>

        <div class="budget-progress-track">
            <div class="budget-progress-bar-fill @progressStatus" style="width: @Math.Min(Model.UsedPercentage, 100)%"></div>
        </div>
    </div>
}

<!-- ── Main Budget Form & Category Grid ── -->
<form asp-action="Save" method="post" id="budget-form">
    @Html.AntiForgeryToken()
    <input asp-for="Month" type="hidden" />
    <input asp-for="Year"  type="hidden" />
    @if (Model.BudgetId > 0) { <input asp-for="BudgetId" type="hidden" /> }

    <div class="row g-4">
        <!-- Left: Total Budget Settings Card -->
        <div class="col-lg-4">
            <div class="total-budget-setting-card animate-fade-in">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-sliders text-primary fs-5"></i>
                    <h2 class="card-title m-0" style="font-size:17px; font-weight:800;">Budget Ceiling</h2>
                </div>

                <div class="mb-3">
                    <label asp-for="TotalBudget" class="form-label" style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--text-muted);">
                        Monthly Total Capital (₹) *
                    </label>
                    <div class="input-group">
                        <span class="input-group-text fw-800" style="background:var(--bg-input); border-color:var(--border-color); color:var(--accent-primary);">₹</span>
                        <input asp-for="TotalBudget" id="total-budget-input" type="number" step="0.01" min="1" class="form-control"
                               placeholder="e.g. 50000" style="font-size:20px; font-weight:800; font-family:'IBM Plex Mono', monospace;" />
                    </div>
                    <span asp-validation-for="TotalBudget" class="text-danger small"></span>

                    <!-- Quick Preset Pills -->
                    <div class="preset-pills-row">
                        <button type="button" class="preset-pill" onclick="setTotalBudget(25000)">₹25k</button>
                        <button type="button" class="preset-pill" onclick="setTotalBudget(50000)">₹50k</button>
                        <button type="button" class="preset-pill" onclick="setTotalBudget(75000)">₹75k</button>
                        <button type="button" class="preset-pill" onclick="setTotalBudget(100000)">₹1 Lakh</button>
                        <button type="button" class="preset-pill" onclick="addTotalBudget(5000)">+₹5k</button>
                    </div>
                </div>

                <!-- Allocation Tracker -->
                <div class="allocation-summary-box">
                    <div class="allocation-row">
                        <span>Total Target</span>
                        <strong id="tracker-target">₹@Model.TotalBudget.ToString("N2")</strong>
                    </div>
                    <div class="allocation-row">
                        <span>Sum of Categories</span>
                        <strong id="tracker-sum" class="text-primary">₹0.00</strong>
                    </div>
                    <div class="allocation-row">
                        <span>Unallocated Buffer</span>
                        <strong id="tracker-buffer" class="text-success">₹0.00</strong>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label" style="font-size:12px; font-weight:700; text-transform:uppercase; color:var(--text-muted);">
                        Strategy Notes (Optional)
                    </label>
                    <textarea asp-for="Notes" class="form-control" rows="3"
                              placeholder="e.g. Saving for festival gifts, cutting dining expenses by 20%..."
                              style="font-size:13px; border-radius:var(--radius-sm); background:var(--bg-input);"></textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 fw-700 shadow-sm rounded-pill d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-check2-circle fs-5"></i> Lock In & Save Budget
                </button>
            </div>
        </div>

        <!-- Right: Category-Wise Budgets Grid -->
        <div class="col-lg-8">
            <div class="category-budget-panel animate-fade-in">
                <!-- Toolbar with Search & Filter Chips -->
                <div class="category-budget-toolbar">
                    <div class="category-budget-search">
                        <i class="bi bi-search"></i>
                        <input id="category-search-input" type="text" placeholder="Filter category by name..." onkeyup="filterCategories()" />
                    </div>

                    <div class="category-filter-chips">
                        <button type="button" class="category-chip active" onclick="setCategoryFilter('all', this)">All (@Model.CategoryBudgets.Count)</button>
                        <button type="button" class="category-chip" onclick="setCategoryFilter('budgeted', this)">Budgeted</button>
                        <button type="button" class="category-chip" onclick="setCategoryFilter('warning', this)">Near Limit</button>
                        <button type="button" class="category-chip" onclick="setCategoryFilter('exceeded', this)">Exceeded</button>
                        <button type="button" class="category-chip" onclick="setCategoryFilter('unset', this)">Unset (₹0)</button>
                    </div>
                </div>

                <!-- Category Items List -->
                <div id="category-items-container">
                    @for (int i = 0; i < Model.CategoryBudgets.Count; i++)
                    {
                        var cb = Model.CategoryBudgets[i];
                        var statusTag = cb.IsExceeded ? "exceeded" : cb.IsWarning ? "warning" : cb.BudgetAmount > 0 ? "healthy" : "unset";
                        var isBudgeted = cb.BudgetAmount > 0;

                        <input type="hidden" name="CategoryBudgets[@i].BudgetCategoryId" value="@cb.BudgetCategoryId" />
                        <input type="hidden" name="CategoryBudgets[@i].CategoryId" value="@cb.CategoryId" />
                        <input type="hidden" name="CategoryBudgets[@i].CategoryName" value="@cb.CategoryName" />
                        <input type="hidden" name="CategoryBudgets[@i].CategoryIcon" value="@cb.CategoryIcon" />
                        <input type="hidden" name="CategoryBudgets[@i].CategoryColor" value="@cb.CategoryColor" />

                        <div class="category-card-item"
                             data-name="@cb.CategoryName.ToLower()"
                             data-status="@statusTag"
                             data-budgeted="@(isBudgeted ? "true" : "false")">

                            <!-- Category Icon Badge -->
                            <div class="cat-icon-badge" style="background:@(cb.CategoryColor ?? "#6366F1")22; color:@(cb.CategoryColor ?? "#6366F1")">
                                <i class="@(cb.CategoryIcon ?? "bi-tag")"></i>
                            </div>

                            <!-- Info & Progress -->
                            <div class="cat-info-block">
                                <div class="cat-name-row">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="cat-name">@cb.CategoryName</span>
                                        @if (cb.IsExceeded)
                                        {
                                            <span class="cat-pill-badge exceeded">🚨 EXCEEDED</span>
                                        }
                                        else if (cb.IsWarning)
                                        {
                                            <span class="cat-pill-badge warning">⚠️ @cb.UsedPercentage%</span>
                                        }
                                        else if (isBudgeted)
                                        {
                                            <span class="cat-pill-badge healthy">@cb.UsedPercentage%</span>
                                        }
                                    </div>
                                    <span style="font-size:12px; font-weight:700; font-family:'IBM Plex Mono', monospace; color:var(--text-primary)">
                                        Spent: ₹@cb.SpentAmount.ToString("N2")
                                    </span>
                                </div>

                                @if (isBudgeted)
                                {
                                    <div class="cat-progress-thin">
                                        <div class="bar @(cb.IsExceeded ? "bg-danger" : cb.IsWarning ? "bg-warning" : "bg-success")"
                                             style="width:@Math.Min(cb.UsedPercentage, 100)%"></div>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted" style="font-size:11.5px">
                                        <span>Target: ₹@cb.BudgetAmount.ToString("N2")</span>
                                        <span>@(cb.Remaining >= 0 ? "₹" + cb.Remaining.ToString("N2") + " safe" : "Over by ₹" + Math.Abs(cb.Remaining).ToString("N2"))</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted" style="font-size:11.5px">
                                        <em>No monthly limit assigned yet</em>
                                    </div>
                                }
                            </div>

                            <!-- Amount Input Cluster -->
                            <div class="cat-input-cluster">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text" style="font-weight:700; background:var(--bg-input); border-color:var(--border-color)">₹</span>
                                    <input type="number"
                                           name="CategoryBudgets[@i].BudgetAmount"
                                           id="cat-input-@i"
                                           value="@cb.BudgetAmount"
                                           min="0" step="100"
                                           class="form-control cat-amount-input fw-700"
                                           style="font-family:'IBM Plex Mono', monospace; font-size:13.5px;"
                                           onchange="recalcCategoryAllocations()"
                                           onkeyup="recalcCategoryAllocations()"
                                           placeholder="0" />
                                </div>
                                <div class="cat-quick-presets">
                                    <button type="button" class="cat-preset-btn" onclick="addCatAmount('cat-input-@i', 500)">+500</button>
                                    <button type="button" class="cat-preset-btn" onclick="addCatAmount('cat-input-@i', 1000)">+1k</button>
                                    <button type="button" class="cat-preset-btn" onclick="addCatAmount('cat-input-@i', 2500)">+2.5k</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let currentFilter = 'all';

        function setTotalBudget(val) {
            const input = document.getElementById('total-budget-input');
            if (input) {
                input.value = val;
                recalcCategoryAllocations();
            }
        }

        function addTotalBudget(delta) {
            const input = document.getElementById('total-budget-input');
            if (input) {
                input.value = (parseFloat(input.value) || 0) + delta;
                recalcCategoryAllocations();
            }
        }

        function addCatAmount(id, delta) {
            const input = document.getElementById(id);
            if (input) {
                input.value = (parseFloat(input.value) || 0) + delta;
                recalcCategoryAllocations();
            }
        }

        function recalcCategoryAllocations() {
            const totalBudget = parseFloat(document.getElementById('total-budget-input')?.value) || 0;
            const catInputs = document.querySelectorAll('.cat-amount-input');
            let totalAllocated = 0;

            catInputs.forEach(inp => {
                totalAllocated += (parseFloat(inp.value) || 0);
            });

            const buffer = totalBudget - totalAllocated;

            const targetEl = document.getElementById('tracker-target');
            const sumEl    = document.getElementById('tracker-sum');
            const buffEl   = document.getElementById('tracker-buffer');

            if (targetEl) targetEl.innerText = '₹' + totalBudget.toLocaleString('en-IN', { minimumFractionDigits: 2 });
            if (sumEl)    sumEl.innerText    = '₹' + totalAllocated.toLocaleString('en-IN', { minimumFractionDigits: 2 });
            if (buffEl) {
                buffEl.innerText = (buffer >= 0 ? '₹' : '-₹') + Math.abs(buffer).toLocaleString('en-IN', { minimumFractionDigits: 2 });
                buffEl.className = buffer >= 0 ? 'text-success' : 'text-danger';
            }
        }

        function setCategoryFilter(filter, btn) {
            currentFilter = filter;
            document.querySelectorAll('.category-chip').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            filterCategories();
        }

        function filterCategories() {
            const query = (document.getElementById('category-search-input')?.value || '').toLowerCase().trim();
            const items = document.querySelectorAll('.category-card-item');

            items.forEach(item => {
                const name = item.getAttribute('data-name') || '';
                const status = item.getAttribute('data-status') || '';
                const isBudgeted = item.getAttribute('data-budgeted') === 'true';

                const matchesQuery = name.includes(query);
                let matchesFilter = true;

                if (currentFilter === 'budgeted') matchesFilter = isBudgeted;
                else if (currentFilter === 'warning') matchesFilter = (status === 'warning');
                else if (currentFilter === 'exceeded') matchesFilter = (status === 'exceeded');
                else if (currentFilter === 'unset') matchesFilter = (status === 'unset');

                item.style.display = (matchesQuery && matchesFilter) ? 'flex' : 'none';
            });
        }

        // Initialize calculations on page load
        document.addEventListener('DOMContentLoaded', () => {
            recalcCategoryAllocations();
        });
    </script>
}
