@model MyDailyExpenseTracker.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Financial Command Center";

    string FormatAmount(decimal amount) => amount.ToString("N2");

    decimal totalCashflow = Model.MonthIncome + Model.MonthExpense;
    int incomeRatio = totalCashflow > 0 ? (int)Math.Round((Model.MonthIncome / totalCashflow) * 100) : 50;
    int expenseRatio = 100 - incomeRatio;

    string paceStatusClass = Model.Forecast.PaceStatus.ToLower() switch {
        "critical" => "critical",
        "accelerating" => "accelerating",
        _ => "ontrack"
    };
}

<!-- AI Spotlight Natural Language Entry -->
<div class="ai-spotlight-card mb-4 animate-fade-in">
    <div class="ai-spotlight-inner">
        <div class="ai-icon-pulse" title="AI Natural Language Assistant">
            <i class="bi bi-stars"></i>
        </div>
        <input type="text" id="ai-spotlight-input" class="ai-spotlight-input"
               placeholder="✨ AI Smart Entry: Type naturally (e.g. 'Coffee ₹180 via UPI', 'Uber 450', 'Salary 85000')..." />
        <button type="button" id="ai-spotlight-btn" class="ai-action-btn">
            <i class="bi bi-stars"></i> Smart Log
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm d-none d-md-flex align-items-center gap-1"
                onclick="openAiChat()" style="border-radius:var(--radius-sm);font-size:13px;border-color:var(--border-dropdown);color:var(--text-secondary)">
            <i class="bi bi-chat-dots"></i> Ask Copilot
        </button>
    </div>
    <!-- Quick prompt sample pills -->
    <div class="d-flex align-items-center gap-2 mt-2 px-1 flex-wrap">
        <span class="text-muted-custom" style="font-size:11px;font-weight:700;letter-spacing:0.04em;"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>TRY PROMPT:</span>
        <button type="button" class="ai-quick-chip" onclick="applySampleEntry('Coffee ₹180 via UPI')">☕ Coffee ₹180 UPI</button>
        <button type="button" class="ai-quick-chip" onclick="applySampleEntry('Grocery ₹1,450 via Card')">🛒 Grocery ₹1,450 Card</button>
        <button type="button" class="ai-quick-chip" onclick="applySampleEntry('Salary ₹85,000 via NetBanking')">💼 Salary ₹85,000</button>
        <button type="button" class="ai-quick-chip" onclick="applySampleEntry('Fuel ₹350 Cash')">⛽ Fuel ₹350 Cash</button>
    </div>
    <div id="ai-preview-panel" class="ai-preview-panel">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div id="ai-preview-chips" class="ai-preview-chips"></div>
            <button type="button" id="ai-confirm-btn" class="btn btn-success btn-sm px-3" style="border-radius:var(--radius-sm);font-weight:600;">
                <i class="bi bi-check-lg me-1"></i> Confirm & Log
            </button>
        </div>
    </div>
</div>

<!-- ── Executive Fintech Hero & Key Metrics ── -->
<div class="row g-4 mb-4">
    <!-- Left Hero: Net Balance & Cashflow -->
    <div class="col-lg-7">
        <div class="fintech-hero-card h-100 animate-fade-in">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div class="fintech-hero-badge">
                    <span class="pulse-dot"></span> Primary Liquid Balance
                </div>
                <span class="badge" style="background:rgba(99,102,241,0.1);color:var(--accent-primary);border:1px solid rgba(99,102,241,0.25);font-size:11.5px;padding:5px 12px;border-radius:20px;">
                    Fintech 2.0 ✨
                </span>
            </div>

            <div class="fintech-hero-amount">
                <span class="currency-symbol">₹</span>@FormatAmount(Math.Abs(Model.TotalBalance))
            </div>

            <div class="fintech-hero-sub">
                <span class="fintech-hero-pill @(Model.TotalBalance >= 0 ? "surplus" : "deficit")">
                    <i class="bi @(Model.TotalBalance >= 0 ? "bi-shield-check" : "bi-exclamation-circle")"></i>
                    @(Model.TotalBalance >= 0 ? "Positive Surplus" : "Account Deficit")
                </span>
                <span>•</span>
                <span>Savings Rate: <strong class="text-primary-custom">@Model.SavingsPercentage%</strong></span>
                <span>•</span>
                <span>@Model.TotalTransactions Total Logs</span>
            </div>

            <!-- Integrated Cashflow Ratio Bar -->
            <div class="fintech-cashflow-wrap">
                <div class="fintech-cashflow-header">
                    <span style="color:#10B981"><i class="bi bi-arrow-down-left me-1"></i>Inflow: ₹@FormatAmount(Model.MonthIncome) (@incomeRatio%)</span>
                    <span style="color:#F43F5E"><i class="bi bi-arrow-up-right me-1"></i>Outflow: ₹@FormatAmount(Model.MonthExpense) (@expenseRatio%)</span>
                </div>
                <div class="fintech-ratio-bar">
                    <div class="fintech-ratio-income" style="width:@incomeRatio%"></div>
                    <div class="fintech-ratio-expense" style="width:@expenseRatio%"></div>
                </div>
            </div>

            <!-- Quick Action Cluster -->
            <div class="fintech-actions-cluster">
                <a href="@Url.Action("Create","Transactions",new{type="Expense"})" class="fintech-action-btn expense">
                    <i class="bi bi-dash-circle-fill"></i> Add Expense
                </a>
                <a href="@Url.Action("Create","Transactions",new{type="Income"})" class="fintech-action-btn income">
                    <i class="bi bi-plus-circle-fill"></i> Add Income
                </a>
                <button type="button" class="fintech-action-btn ai" onclick="openAiChat()">
                    <i class="bi bi-stars"></i> Ask Copilot
                </button>
                <a href="@Url.Action("Index","Reports")" class="fintech-action-btn outline">
                    <i class="bi bi-bar-chart-fill"></i> Analytics
                </a>
            </div>
        </div>
    </div>

    <!-- Right: 3 KPI Cards -->
    <div class="col-lg-5">
        <div class="row g-3 h-100">
            <!-- Inflow / Income KPI -->
            <div class="col-sm-6">
                <div class="fintech-kpi-card animate-fade-in">
                    <div class="fintech-kpi-top">
                        <span class="fintech-kpi-label">Month Inflow</span>
                        <div class="fintech-kpi-icon" style="background:rgba(16,185,129,0.12);color:#10B981;">
                            <i class="bi bi-arrow-down-left"></i>
                        </div>
                    </div>
                    <div class="fintech-kpi-value text-income">
                        ₹@FormatAmount(Model.MonthIncome)
                    </div>
                    <div class="fintech-kpi-footer">
                        <i class="bi bi-calendar-event"></i> Today: ₹@FormatAmount(Model.TodayIncome)
                    </div>
                </div>
            </div>

            <!-- Outflow / Expense KPI -->
            <div class="col-sm-6">
                <div class="fintech-kpi-card animate-fade-in">
                    <div class="fintech-kpi-top">
                        <span class="fintech-kpi-label">Month Outflow</span>
                        <div class="fintech-kpi-icon" style="background:rgba(244,63,94,0.12);color:#F43F5E;">
                            <i class="bi bi-arrow-up-right"></i>
                        </div>
                    </div>
                    <div class="fintech-kpi-value text-expense">
                        ₹@FormatAmount(Model.MonthExpense)
                    </div>
                    <div class="fintech-kpi-footer">
                        @if (Model.PrevMonthExpense > 0)
                        {
                            var diff = Model.MonthExpense - Model.PrevMonthExpense;
                            var isUp = diff > 0;
                            <span class="@(isUp ? "text-danger" : "text-success") fw-600">
                                <i class="bi @(isUp ? "bi-arrow-up" : "bi-arrow-down")"></i>
                                @(isUp ? "+" : "")₹@FormatAmount(Math.Abs(diff))
                            </span>
                            <span>vs last mo</span>
                        }
                        else
                        {
                            <span>Today: ₹@FormatAmount(Model.TodayExpense)</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Safe Daily Runway & Burn Rate -->
            <div class="col-12">
                <div class="fintech-kpi-card animate-fade-in">
                    <div class="fintech-kpi-top">
                        <div>
                            <span class="fintech-kpi-label">Burn Rate & Runway</span>
                            <div class="text-muted-custom mt-1" style="font-size:12px;">
                                @Model.Forecast.DaysRemaining days remaining in current billing cycle
                            </div>
                        </div>
                        <div class="fintech-kpi-icon" style="background:rgba(245,158,11,0.12);color:#F59E0B;">
                            <i class="bi bi-speedometer2"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 my-1">
                        <div>
                            <span class="text-muted-custom" style="font-size:12px;">Safe Daily Spend:</span>
                            <div class="fintech-kpi-value text-success mb-0" style="font-size:22px;">
                                ₹@FormatAmount(Model.Forecast.SafeDailyBudget)<small style="font-size:13px;font-weight:500;color:var(--text-muted)">/day</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="text-muted-custom" style="font-size:12px;">Current Burn:</span>
                            <div class="fw-700 text-primary-custom" style="font-size:16px;">
                                ₹@FormatAmount(Model.Forecast.DailyBurnRate)<small style="font-size:12px;font-weight:400;color:var(--text-muted)">/day</small>
                            </div>
                        </div>
                    </div>
                    <div class="fintech-kpi-footer justify-content-between pt-2 border-top border-subtle-custom mt-2">
                        <span>Pace Status:</span>
                        <span class="burn-pace-pill @paceStatusClass" style="margin:0;">
                            <i class="bi bi-record-fill" style="font-size:8px;"></i> @Model.Forecast.PaceStatus
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Budget Progress Bar (if budget set) -->
@if (Model.MonthlyBudget.HasValue)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-700">Monthly Budget Progress</span>
                <span class="fw-700 @(Model.IsBudgetExceeded ? "text-expense" : Model.IsBudgetWarning ? "text-warning" : "text-income")">
                    @Model.BudgetUsedPercentage%
                </span>
            </div>
            <div class="progress" style="height:10px">
                <div class="progress-bar @(Model.IsBudgetExceeded ? "bg-danger" : Model.IsBudgetWarning ? "bg-warning" : "bg-success")"
                     role="progressbar"
                     style="width:@Math.Min(Model.BudgetUsedPercentage, 100)%"></div>
            </div>
            <div class="d-flex justify-content-between mt-1" style="font-size:12px;color:var(--text-muted)">
                <span>₹@FormatAmount(Model.MonthExpense) spent</span>
                <span>₹@FormatAmount(Model.MonthlyBudget ?? 0) budget</span>
            </div>
        </div>
    </div>
}

<!-- AI Financial Intelligence Hub -->
<div class="row g-4 mb-4">
    <!-- Health Score Ring -->
    <div class="col-lg-4 col-md-6">
        <div class="health-score-card h-100 animate-fade-in">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-700 text-primary-custom d-flex align-items-center gap-2">
                    <i class="bi bi-heart-pulse-fill text-danger"></i> AI Health Score
                </span>
                <span class="badge" style="background:rgba(168,85,247,0.15);color:#A855F7;border:1px solid rgba(168,85,247,0.3);font-size:11px;">
                    @Model.HealthScore.Grade • @Model.HealthScore.StatusBadge
                </span>
            </div>

            <div class="health-gauge-wrap">
                <svg class="health-gauge-svg" viewBox="0 0 140 140">
                    <defs>
                        <linearGradient id="aiGaugeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#6366F1" />
                            <stop offset="50%" stop-color="#A855F7" />
                            <stop offset="100%" stop-color="#EC4899" />
                        </linearGradient>
                    </defs>
                    <circle class="health-gauge-bg" cx="70" cy="70" r="56"></circle>
                    @{
                        double circumference = 2 * Math.PI * 56;
                        double dashOffset = circumference - (circumference * Math.Clamp(Model.HealthScore.Score, 5, 100) / 100.0);
                    }
                    <circle class="health-gauge-bar" cx="70" cy="70" r="56"
                            stroke-dasharray="@circumference"
                            stroke-dashoffset="@dashOffset"></circle>
                </svg>
                <div class="health-gauge-content">
                    <div class="health-score-number">@Model.HealthScore.Score</div>
                    <small class="text-muted-custom" style="font-size:11px;">out of 100</small>
                </div>
            </div>

            <div class="text-center mb-3">
                <div class="fw-700 text-primary-custom" style="font-size:14px;">@Model.HealthScore.Title</div>
                <small class="text-muted-custom d-block mt-1" style="font-size:12px;line-height:1.4;">@Model.HealthScore.Summary</small>
            </div>

            <div class="pillar-group pt-2 border-top border-subtle-custom">
                <div class="pillar-row">
                    <div class="pillar-header">
                        <span>Savings Discipline</span>
                        <span>@Model.HealthScore.SavingsRatioScore%</span>
                    </div>
                    <div class="pillar-track">
                        <div class="pillar-fill" style="width:@Model.HealthScore.SavingsRatioScore%;"></div>
                    </div>
                </div>
                <div class="pillar-row mb-0">
                    <div class="pillar-header">
                        <span>Budget Adherence</span>
                        <span>@Model.HealthScore.BudgetDisciplineScore%</span>
                    </div>
                    <div class="pillar-track">
                        <div class="pillar-fill" style="width:@Model.HealthScore.BudgetDisciplineScore%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- AI Burn Rate & Runway Forecast -->
    <div class="col-lg-4 col-md-6">
        <div class="burn-rate-card h-100 animate-fade-in">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-700 text-primary-custom d-flex align-items-center gap-2">
                    <i class="bi bi-speedometer2 text-warning"></i> Burn Rate & Runway
                </span>
                @{
                    string pillClass = Model.Forecast.PaceStatus.ToLower() switch {
                        "critical" => "critical",
                        "accelerating" => "accelerating",
                        _ => "ontrack"
                    };
                }
                <span class="burn-pace-pill @pillClass">
                    <i class="bi bi-record-fill" style="font-size:8px;"></i> @Model.Forecast.PaceStatus
                </span>
            </div>

            <div class="p-3 rounded-3 mb-3" style="background:var(--bg-card-hover);border:1px solid var(--border-subtle);">
                <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <span class="text-muted-custom" style="font-size:12px;">Daily Spending Velocity</span>
                    <strong class="text-primary-custom fs-5">₹@FormatAmount(Model.Forecast.DailyBurnRate)<small style="font-size:12px;font-weight:400;">/day</small></strong>
                </div>
                <div class="d-flex justify-content-between align-items-baseline">
                    <span class="text-muted-custom" style="font-size:12px;">Safe Daily Allowance</span>
                    <span class="text-success fw-700">₹@FormatAmount(Model.Forecast.SafeDailyBudget)<small style="font-size:12px;font-weight:400;">/day</small></span>
                </div>
            </div>

            <div class="d-flex justify-content-between mb-2" style="font-size:13px;">
                <span class="text-muted-custom">Projected Month-End Spend:</span>
                <strong class="text-primary-custom">₹@FormatAmount(Model.Forecast.ProjectedMonthEndExpense)</strong>
            </div>
            <div class="d-flex justify-content-between mb-3" style="font-size:13px;">
                <span class="text-muted-custom">Days Remaining in Month:</span>
                <span class="fw-700 text-primary-custom">@Model.Forecast.DaysRemaining days</span>
            </div>

            @if (Model.Forecast.WillExceedBudget)
            {
                <div class="alert alert-danger p-2 mb-0 d-flex align-items-center gap-2" style="font-size:12px;border-radius:var(--radius-sm);">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                    <span>At this velocity, you'll exceed budget by ₹@FormatAmount(Math.Abs(Model.Forecast.ProjectedBalance)).</span>
                </div>
            }
            else
            {
                <div class="alert alert-success p-2 mb-0 d-flex align-items-center gap-2" style="font-size:12px;border-radius:var(--radius-sm);">
                    <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                    <span>Pacing smoothly. Estimated surplus: ₹@FormatAmount(Model.Forecast.ProjectedBalance).</span>
                </div>
            }
        </div>
    </div>

    <!-- AI Copilot Live Insights & Prompts -->
    <div class="col-lg-4 col-12">
        <div class="card h-100 animate-fade-in" style="border:var(--ai-border);">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-700 text-primary-custom d-flex align-items-center gap-2">
                    <i class="bi bi-stars text-primary"></i> AI Copilot Actions
                </span>
                <a href="@Url.Action("Index","AiInsights")" class="btn btn-link btn-sm p-0 text-decoration-none" style="font-size:12px;color:var(--accent-primary);">
                    Full Studio <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <p class="text-secondary-custom mb-3" style="font-size:13px;line-height:1.5;">
                        Tap an instant query to consult your AI Financial Advisor with account-specific calculations:
                    </p>
                    <div class="d-flex flex-column gap-2 mb-3">
                        <button type="button" class="ai-prompt-chip justify-content-between w-100" data-prompt="Where did I spend the most this month?">
                            <span><i class="bi bi-pie-chart me-1"></i> Top spending category</span>
                            <i class="bi bi-chevron-right text-muted-custom"></i>
                        </button>
                        <button type="button" class="ai-prompt-chip justify-content-between w-100" data-prompt="How can I save ₹3,000 more this month?">
                            <span><i class="bi bi-piggy-bank me-1"></i> 3-step savings plan</span>
                            <i class="bi bi-chevron-right text-muted-custom"></i>
                        </button>
                        <button type="button" class="ai-prompt-chip justify-content-between w-100" data-prompt="Will I exceed my monthly budget?">
                            <span><i class="bi bi-speedometer2 me-1"></i> Check budget runway</span>
                            <i class="bi bi-chevron-right text-muted-custom"></i>
                        </button>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm w-100 d-flex align-items-center justify-content-center gap-2"
                        onclick="openAiChat()" style="border-radius:var(--radius-sm);font-weight:600;">
                    <i class="bi bi-chat-dots-fill"></i> Open AI Copilot Chat
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 1 -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="card-title">Income vs Expense (Last 6 Months)</h2>
            </div>
            <div class="card-body">
                <div class="chart-container" style="height:260px">
                    <canvas id="incomeExpenseChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="card-title">Category Breakdown</h2>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div class="chart-container w-100" style="height:260px">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 2 -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="card-title">Daily Expense Trend</h2>
                <span style="font-size:12px;color:var(--text-muted)">@DateTime.Now.ToString("MMMM yyyy")</span>
            </div>
            <div class="card-body">
                <div class="chart-container" style="height:220px">
                    <canvas id="dailyTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="card-title">Payment Methods</h2>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div class="chart-container" style="height:220px">
                    <canvas id="paymentChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Recent Activity Feed (Copilot & Revolut Style) ── -->
<div class="card mb-4 animate-fade-in">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h2 class="card-title">Recent Activity Feed</h2>
            <small class="text-muted-custom" style="font-size:12px;">Real-time ledger updates & expense stream</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Index","Transactions")" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" style="border-radius:var(--radius-sm);font-weight:600;">
                View All (@Model.TotalTransactions) <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-3">
        @if (Model.RecentTransactions.Any())
        {
            <div class="fintech-feed">
                @foreach (var tx in Model.RecentTransactions)
                {
                    <div class="fintech-feed-item">
                        <div class="fintech-feed-left">
                            <div class="category-icon-badge" style="--cat-color: @(string.IsNullOrEmpty(tx.CategoryColor) ? "#6366F1" : tx.CategoryColor);">
                                <i class="@(string.IsNullOrEmpty(tx.CategoryIcon) ? "bi bi-tag-fill" : tx.CategoryIcon)"></i>
                            </div>
                            <div class="fintech-feed-info">
                                <div class="fintech-feed-title">@tx.Description</div>
                                <div class="fintech-feed-tags">
                                    <span class="fintech-tag-pill">
                                        <i class="bi bi-tag" style="color:@(string.IsNullOrEmpty(tx.CategoryColor) ? "#6366F1" : tx.CategoryColor)"></i>
                                        @tx.CategoryName
                                    </span>
                                    @if (!string.IsNullOrEmpty(tx.PaymentMethodName))
                                    {
                                        <span class="fintech-tag-pill">
                                            <i class="bi bi-credit-card"></i>
                                            @tx.PaymentMethodName
                                        </span>
                                    }
                                    <span>•</span>
                                    <span>@tx.TransactionDate.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <div class="fintech-feed-right">
                            <div class="fintech-feed-amount @(tx.Type == "Expense" ? "expense" : "income")">
                                @(tx.Type == "Expense" ? "−" : "+")₹@FormatAmount(tx.Amount)
                            </div>
                            <div class="fintech-feed-actions">
                                <a href="@Url.Action("Edit","Transactions",new{id=tx.TransactionId})"
                                   class="fintech-mini-btn edit" title="Edit transaction">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <button type="button"
                                        class="fintech-mini-btn delete"
                                        title="Delete transaction"
                                        data-delete-form="del-@tx.TransactionId"
                                        data-delete-label="@tx.Description">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                                <form id="del-@tx.TransactionId" method="post"
                                      asp-action="Delete" asp-controller="Transactions"
                                      asp-route-id="@tx.TransactionId">
                                    @Html.AntiForgeryToken()
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state py-5">
                <div class="empty-icon"><i class="bi bi-wallet2"></i></div>
                <h5>No Activity Logged Yet</h5>
                <p>Start recording your daily expenses or use AI Smart Log above.</p>
                <a href="@Url.Action("Create","Transactions",new{type="Expense"})" class="btn btn-primary btn-sm mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Log First Expense
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
    (function() {
        // Sample entry helper
        window.applySampleEntry = function(text) {
            const input = document.getElementById('ai-spotlight-input');
            if (input) {
                input.value = text;
                input.focus();
                document.getElementById('ai-spotlight-btn')?.click();
            }
        };

        // ── Modern Curated Fintech Palette ────────────────────────────────
        const COLORS = [
            '#6366F1', '#10B981', '#F59E0B', '#F43F5E', '#3B82F6',
            '#8B5CF6', '#EC4899', '#06B6D4', '#F97316', '#14B8A6'
        ];

        // ── Data from server ─────────────────────────────────────────────
        const incomeExpenseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyIncomeVsExpenseChart));
        const categoryData      = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryExpenseChart));
        const dailyData         = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyExpenseTrend));
        const paymentData       = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentMethodChart));

        const labels = Object.keys(incomeExpenseData);
        const incomes  = labels.map(k => incomeExpenseData[k].income);
        const expenses = labels.map(k => incomeExpenseData[k].expense);

        // ── Income vs Expense Bar Chart ───────────────────────────────────
        const barCanvas = document.getElementById('incomeExpenseChart');
        if (barCanvas) {
            new Chart(barCanvas, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [
                        {
                            label: 'Income',
                            data: incomes,
                            backgroundColor: 'rgba(16, 185, 129, 0.85)',
                            hoverBackgroundColor: '#10B981',
                            borderRadius: 8,
                            borderSkipped: false,
                            maxBarThickness: 32
                        },
                        {
                            label: 'Expense',
                            data: expenses,
                            backgroundColor: 'rgba(244, 63, 94, 0.85)',
                            hoverBackgroundColor: '#F43F5E',
                            borderRadius: 8,
                            borderSkipped: false,
                            maxBarThickness: 32
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: { usePointStyle: true, boxWidth: 8, font: { family: 'Outfit', weight: '600' } }
                        }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            beginAtZero: true,
                            border: { dash: [4, 4] },
                            ticks: { callback: v => '₹' + v.toLocaleString('en-IN') }
                        }
                    }
                }
            });
        }

        // ── Category Doughnut Chart ───────────────────────────────────────
        const catCanvas = document.getElementById('categoryChart');
        const catLabels = Object.keys(categoryData);
        const catValues = catLabels.map(k => categoryData[k]);
        if (catCanvas && catValues.length > 0) {
            new Chart(catCanvas, {
                type: 'doughnut',
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catValues,
                        backgroundColor: COLORS.slice(0, catLabels.length),
                        borderWidth: 3,
                        borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#131D31' : '#FFFFFF',
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '74%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: { boxWidth: 10, usePointStyle: true, font: { family: 'Outfit', size: 12 } }
                        }
                    }
                }
            });
        }

        // ── Daily Trend Line Chart (Area Gradient) ────────────────────────
        const trendCanvas = document.getElementById('dailyTrendChart');
        if (trendCanvas) {
            const ctx = trendCanvas.getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 220);
            gradient.addColorStop(0, 'rgba(99, 102, 241, 0.35)');
            gradient.addColorStop(1, 'rgba(99, 102, 241, 0.0)');

            new Chart(trendCanvas, {
                type: 'line',
                data: {
                    labels: Object.keys(dailyData),
                    datasets: [{
                        label: 'Expense (₹)',
                        data: Object.values(dailyData),
                        borderColor: '#6366F1',
                        backgroundColor: gradient,
                        borderWidth: 2.8,
                        tension: 0.45,
                        fill: true,
                        pointBackgroundColor: '#6366F1',
                        pointBorderColor: '#FFFFFF',
                        pointBorderWidth: 1.5,
                        pointRadius: 3.5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            beginAtZero: true,
                            border: { dash: [4, 4] },
                            ticks: { callback: v => '₹' + v }
                        }
                    }
                }
            });
        }

        // ── Payment Method Chart (Modern Doughnut) ────────────────────────
        const payCanvas = document.getElementById('paymentChart');
        const pmLabels = Object.keys(paymentData);
        const pmValues = pmLabels.map(k => paymentData[k]);
        if (payCanvas && pmValues.length > 0) {
            new Chart(payCanvas, {
                type: 'doughnut',
                data: {
                    labels: pmLabels,
                    datasets: [{
                        data: pmValues,
                        backgroundColor: COLORS.slice(2, 2 + pmLabels.length),
                        borderWidth: 2,
                        borderColor: document.documentElement.getAttribute('data-theme') === 'dark' ? '#131D31' : '#FFFFFF',
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 10, usePointStyle: true, font: { family: 'Outfit', size: 12 } }
                        }
                    }
                }
            });
        }
    })();
    </script>
}
