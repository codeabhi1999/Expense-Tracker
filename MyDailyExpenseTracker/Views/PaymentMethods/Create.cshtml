@model MyDailyExpenseTracker.ViewModels.PaymentMethodViewModel
@{
    bool isEdit = Model.PaymentMethodId > 0;
    ViewData["Title"] = isEdit ? "Edit Payment Method" : "Add Payment Method";
    ViewData["PageTitle"] = ViewData["Title"]?.ToString();
}
<div class="page-header">
    <h1><i class="bi bi-credit-card-fill me-2"></i>@ViewData["Title"]</h1>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body" style="padding:28px">
                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                    @Html.AntiForgeryToken()
                    @if (isEdit) { <input asp-for="PaymentMethodId" type="hidden" /> }
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Payment Method Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. PhonePe, Google Pay" maxlength="100" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Icon" class="form-label">Icon <span class="text-muted-custom fw-400">(Bootstrap Icons class)</span></label>
                        <div class="input-group">
                            <span class="input-group-text" id="icon-preview"><i class="bi bi-credit-card"></i></span>
                            <input asp-for="Icon" class="form-control" placeholder="e.g. bi-phone" id="icon-input" />
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary flex-grow-1 py-2">
                            <i class="bi bi-check-circle me-2"></i>@(isEdit ? "Update" : "Add") Method
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
document.getElementById('icon-input')?.addEventListener('input', function() {
    document.getElementById('icon-preview').querySelector('i').className = 'bi ' + this.value;
});
</script>
}
