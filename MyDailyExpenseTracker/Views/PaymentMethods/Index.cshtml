@model List<MyDailyExpenseTracker.ViewModels.PaymentMethodViewModel>
@{
    ViewData["Title"]     = "Payment Methods";
    ViewData["PageTitle"] = "Payment Methods";
}

<div class="page-header">
    <h1><i class="bi bi-credit-card-fill me-2"></i>Payment Methods</h1>
    <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add Method
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-0">
                @if (Model.Any())
                {
                    <table class="data-table">
                        <thead>
                            <tr><th>Payment Method</th><th>Transactions</th><th>Type</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var pm in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div style="width:36px;height:36px;border-radius:8px;background:rgba(99,102,241,.1);display:flex;align-items:center;justify-content:center;color:var(--accent-primary);font-size:16px">
                                                <i class="@(pm.Icon ?? "bi-credit-card")"></i>
                                            </div>
                                            <span class="fw-600">@pm.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-muted-custom">@pm.TransactionCount txns</td>
                                    <td>
                                        @if (pm.IsDefault)
                                        {
                                            <span class="badge" style="background:rgba(99,102,241,.1);color:var(--accent-primary);font-weight:600;font-size:11px">System Default</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background:rgba(34,197,94,.1);color:var(--color-income);font-weight:600;font-size:11px">Custom</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!pm.IsDefault)
                                        {
                                            <div class="d-flex gap-1">
                                                <a href="@Url.Action("Edit", new { id = pm.PaymentMethodId })"
                                                   class="btn btn-sm" style="background:rgba(59,130,246,.1);color:#3B82F6;border:none;">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                @if (pm.TransactionCount == 0)
                                                {
                                                    <button type="button" class="btn btn-sm"
                                                            style="background:rgba(239,68,68,.1);color:#EF4444;border:none;"
                                                            data-delete-form="del-pm-@pm.PaymentMethodId"
                                                            data-delete-label="@pm.Name">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                    <form id="del-pm-@pm.PaymentMethodId" method="post"
                                                          asp-action="Delete" asp-route-id="@pm.PaymentMethodId">
                                                        @Html.AntiForgeryToken()
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span title="In use — cannot delete" class="btn btn-sm disabled"
                                                          style="background:rgba(148,163,184,.1);color:var(--text-muted);border:none;">
                                                        <i class="bi bi-lock"></i>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon"><i class="bi bi-credit-card"></i></div>
                        <h5>No Custom Payment Methods</h5>
                        <p>System defaults (Cash, UPI, Credit Card, etc.) are already available.</p>
                        <a href="@Url.Action("Create")" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-1"></i>Add Custom Method
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
