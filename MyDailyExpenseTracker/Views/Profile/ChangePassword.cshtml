@model MyDailyExpenseTracker.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"]     = "Change Password";
    ViewData["PageTitle"] = "Change Password";
}

<div class="page-header">
    <h1><i class="bi bi-shield-lock-fill me-2"></i>Change Password</h1>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Profile</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body" style="padding:28px">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="CurrentPassword" type="password" class="form-control" id="cur-pw" />
                            <button type="button" class="input-group-text" onclick="togglePw('cur-pw',this)" style="cursor:pointer"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="NewPassword" type="password" class="form-control" id="new-pw" />
                            <button type="button" class="input-group-text" onclick="togglePw('new-pw',this)" style="cursor:pointer"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" id="conf-pw" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="alert alert-info" style="font-size:12px">
                        <strong>Password requirements:</strong> Minimum 8 characters, at least 1 uppercase letter and 1 digit.
                    </div>
                    <div class="d-flex gap-3 mt-3">
                        <button type="submit" class="btn btn-primary flex-grow-1 py-2">
                            <i class="bi bi-check-circle me-2"></i>Change Password
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function togglePw(id, btn) {
    const input = document.getElementById(id);
    const icon = btn.querySelector('i');
    input.type = input.type === 'password' ? 'text' : 'password';
    icon.className = input.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
}
</script>
}
