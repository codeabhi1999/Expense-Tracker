@model MyDailyExpenseTracker.ViewModels.RecurringExpenseViewModel
@{ 
    ViewData["Title"] = "Edit Recurring Expense"; 
    ViewData["PageTitle"] = "Edit Recurring Expense";
}
@await Html.PartialAsync("Create", Model)

@section Scripts {
    <script>
    document.getElementById('re-type')?.addEventListener('change', function () {
        const type = this.value;
        fetch('/Transactions/GetCategoriesByType?type=' + encodeURIComponent(type))
            .then(r => r.json())
            .then(data => {
                const sel = document.getElementById('re-category');
                if (!sel) return;
                const cur = sel.value;
                sel.innerHTML = '<option value="">Select Category</option>';
                data.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.value;
                    opt.text = c.text;
                    if (c.value === cur) opt.selected = true;
                    sel.appendChild(opt);
                });
            })
            .catch(err => console.error('Error fetching categories:', err));
    });
    </script>
}
