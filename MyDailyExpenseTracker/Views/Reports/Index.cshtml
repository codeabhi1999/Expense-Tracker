@model MyDailyExpenseTracker.ViewModels.ReportViewModel
@{
    ViewData["Title"]     = "Monthly Report";
    ViewData["PageTitle"] = "Monthly Report";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
}

<div class="page-header">
    <h1><i class="bi bi-bar-chart-fill me-2"></i>Report — @monthName</h1>
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
        <select name="month" class="form-select form-select-sm" style="width:130px">
            @for (int m = 1; m <= 12; m++)
            {
                var mName = new DateTime(2000, m, 1).ToString("MMMM");
                if (m == Model.Month) { <option value="@m" selected>@mName</option> }
                else                  { <option value="@m">@mName</option> }
            }
        </select>
        <select name="year" class="form-select form-select-sm" style="width:90px">
            @foreach (var y in Model.AvailableYears)
            {
                if (y == Model.Year) { <option value="@y" selected>@y</option> }
                else                 { <option value="@y">@y</option> }
            }
        </select>
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-arrow-clockwise"></i></button>
    </form>
</div>

<!-- Summary Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card income"><div class="stat-icon"><i class="bi bi-arrow-up-circle-fill"></i></div>
            <div class="stat-label">Total Income</div>
            <div class="stat-value text-income">₹@Model.TotalIncome.ToString("N2")</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card expense"><div class="stat-icon"><i class="bi bi-arrow-down-circle-fill"></i></div>
            <div class="stat-label">Total Expense</div>
            <div class="stat-value text-expense">₹@Model.TotalExpense.ToString("N2")</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card balance"><div class="stat-icon"><i class="bi bi-piggy-bank-fill"></i></div>
            <div class="stat-label">Total Savings</div>
            <div class="stat-value @(Model.TotalSavings >= 0 ? "text-balance" : "text-expense")">
                ₹@Math.Abs(Model.TotalSavings).ToString("N2")
            </div>
            <div class="stat-change">@Model.SavingsPercentage% of income</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card expense"><div class="stat-icon"><i class="bi bi-arrow-up-right-circle-fill"></i></div>
            <div class="stat-label">Highest Expense</div>
            <div class="stat-value text-expense" style="font-size:20px">₹@Model.HighestExpense.ToString("N2")</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card warning"><div class="stat-icon"><i class="bi bi-calendar-day"></i></div>
            <div class="stat-label">Avg Daily Expense</div>
            <div class="stat-value" style="font-size:20px;color:var(--color-warning)">₹@Model.AverageDailyExpense.ToString("N2")</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card"><div class="stat-icon" style="background:rgba(99,102,241,.1);color:var(--accent-primary)"><i class="bi bi-receipt"></i></div>
            <div class="stat-label">Transactions</div>
            <div class="stat-value" style="color:var(--accent-primary)">@Model.TotalTransactions</div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><h2 class="card-title">Category Breakdown</h2></div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div class="chart-container w-100" style="height:280px">
                    <canvas id="catChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header"><h2 class="card-title">Daily Expense Trend</h2></div>
            <div class="card-body">
                <div class="chart-container" style="height:280px">
                    <canvas id="dailyChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Category Breakdown Table -->
@if (Model.CategoryBreakdowns.Any())
{
    <div class="card mb-4">
        <div class="card-header"><h2 class="card-title">Category-wise Breakdown</h2></div>
        <div class="card-body p-0">
            <table class="data-table">
                <thead><tr><th>Category</th><th>Amount</th><th>Transactions</th><th>% of Total</th><th>Bar</th></tr></thead>
                <tbody>
                    @foreach (var cb in Model.CategoryBreakdowns)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:28px;height:28px;border-radius:6px;background:@(cb.CategoryColor ?? "#6366F1")22;display:flex;align-items:center;justify-content:center;color:@(cb.CategoryColor ?? "#6366F1")">
                                        <i class="@(cb.CategoryIcon ?? "bi-tag")" style="font-size:13px"></i>
                                    </div>
                                    <span class="fw-600">@cb.CategoryName</span>
                                </div>
                            </td>
                            <td class="amount-expense fw-700">₹@cb.Amount.ToString("N2")</td>
                            <td class="text-muted-custom">@cb.Count</td>
                            <td class="fw-600">@cb.Percentage%</td>
                            <td style="width:200px">
                                <div class="progress" style="height:6px">
                                    <div class="progress-bar" style="width:@cb.Percentage%;background:@(cb.CategoryColor ?? "#6366F1")"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Transactions Table -->
<div class="card">
    <div class="card-header">
        <h2 class="card-title">All Transactions in @monthName</h2>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Export","Transactions",new{format="csv",month=Model.Month,year=Model.Year})" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-filetype-csv me-1"></i>Export CSV
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.Transactions.Any())
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Date</th><th>Description</th><th>Category</th><th>Type</th><th>Amount</th></tr></thead>
                    <tbody>
                        @foreach (var tx in Model.Transactions)
                        {
                            <tr>
                                <td class="no-wrap">@tx.TransactionDate.ToString("dd MMM")</td>
                                <td>@tx.Description</td>
                                <td><span class="category-pill">@tx.CategoryName</span></td>
                                <td><span class="type-badge @tx.Type.ToLower()">@tx.Type</span></td>
                                <td class="@(tx.Type=="Expense"?"amount-expense":"amount-income") fw-700 no-wrap">
                                    @(tx.Type=="Expense"?"−":"+")₹@tx.Amount.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state"><div class="empty-icon"><i class="bi bi-inbox"></i></div><h5>No transactions in @monthName</h5></div>
        }
    </div>
</div>

@section Scripts {
<script>
const COLORS = ['#6366F1','#22C55E','#F59E0B','#EF4444','#3B82F6','#8B5CF6','#EC4899','#14B8A6'];
const catData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryExpenseChart));
const dailyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyExpenseTrend));

// Category Doughnut
const catLabels = Object.keys(catData);
if (catLabels.length > 0) {
    new Chart(document.getElementById('catChart'), {
        type: 'doughnut',
        data: { labels: catLabels, datasets: [{ data: catLabels.map(k=>catData[k]), backgroundColor: COLORS, borderWidth:0 }] },
        options: { responsive:true, maintainAspectRatio:false, cutout:'65%', plugins: { legend: { position:'right', labels:{boxWidth:12} } } }
    });
}

// Daily Trend
new Chart(document.getElementById('dailyChart'), {
    type: 'bar',
    data: {
        labels: Object.keys(dailyData),
        datasets: [{ label:'Expense (₹)', data: Object.values(dailyData), backgroundColor:'rgba(239,68,68,.7)', borderRadius:4 }]
    },
    options: { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{ y:{beginAtZero:true, ticks:{callback:v=>'₹'+v}} } }
});
</script>
}
