@using Microsoft.AspNetCore.Identity
@using MyDailyExpenseTracker.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="My Daily Expense Tracker — Track, manage and analyze your daily income and expenses." />
    <title>@ViewData["Title"] | My Daily Expense Tracker</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- App CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
@{
    var isAuth = SignInManager.IsSignedIn(User);
    ApplicationUser? currentUser = null;
    string? userInitials = null;
    string? userTheme = "light";
    int unreadCount = 0;

    if (isAuth)
    {
        currentUser = await UserManager.GetUserAsync(User);
        userInitials = ((currentUser?.FirstName?.FirstOrDefault() ?? ' ').ToString() +
                        (currentUser?.LastName?.FirstOrDefault() ?? ' ').ToString()).Trim().ToUpper();
        userTheme = currentUser?.Theme ?? "light";
    }
}

@* Hidden input so JS can read server-set theme *@
<input type="hidden" id="user-theme" value="@userTheme" />

@if (isAuth)
{
    <!-- Sidebar Overlay (mobile) -->
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <div class="mesh-bg-container">
        <div class="mesh-blob mesh-blob-1"></div>
        <div class="mesh-blob mesh-blob-2"></div>
        <div class="mesh-blob mesh-blob-3"></div>
    </div>

    <div class="app-wrapper">
        <!-- ── Sidebar ── -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon"><i class="bi bi-wallet2"></i></div>
                <div class="brand-text">
                    My Daily
                    <small>Expense Tracker</small>
                </div>
            </div>

            <div class="sidebar-nav">
                <div class="nav-section-title">Main</div>

                <a href="@Url.Action("Index","Dashboard")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>

                <a href="@Url.Action("Index","Transactions")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transactions" ? "active" : "")">
                    <i class="bi bi-arrow-left-right"></i> Transactions
                </a>

                <div class="nav-section-title">Manage</div>

                <a href="@Url.Action("Index","Categories")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">
                    <i class="bi bi-tag-fill"></i> Categories
                </a>

                <a href="@Url.Action("Index","PaymentMethods")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PaymentMethods" ? "active" : "")">
                    <i class="bi bi-credit-card-fill"></i> Payment Methods
                </a>

                <a href="@Url.Action("Index","Budget")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Budget" ? "active" : "")">
                    <i class="bi bi-pie-chart-fill"></i> Budget
                </a>

                <a href="@Url.Action("Index","RecurringExpenses")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "RecurringExpenses" ? "active" : "")">
                    <i class="bi bi-arrow-repeat"></i> Recurring
                </a>

                <div class="nav-section-title">Insights</div>

                <a href="@Url.Action("Index","Reports")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-fill"></i> Reports
                </a>

                <div class="nav-section-title">Account</div>

                <a href="@Url.Action("Index","Profile")"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")">
                    <i class="bi bi-person-fill"></i> Profile
                </a>

                <form method="post" asp-action="Logout" asp-controller="Account">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-link w-100 text-start"
                            style="background:none;border:none;cursor:pointer;color:var(--text-sidebar);">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </nav>

        <!-- ── Main Content ── -->
        <div class="main-content">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <button id="sidebar-toggle" class="sidebar-toggle" aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>

                <span class="page-title">@(ViewData["PageTitle"] ?? ViewData["Title"] ?? "Dashboard")</span>

                <div class="navbar-actions">
                    <!-- Add Transaction Quick Button -->
                    <a href="@Url.Action("Create","Transactions")" class="btn btn-primary btn-sm d-none d-md-flex align-items-center gap-2">
                        <i class="bi bi-plus-lg"></i> Add Transaction
                    </a>

                    <!-- Theme Toggle -->
                    <button id="theme-toggle" class="btn-icon" title="Toggle theme">
                        <i id="theme-icon" class="bi bi-moon-fill"></i>
                    </button>

                    <!-- Notifications -->
                    <div class="dropdown">
                        <button id="notifications-btn" class="btn-icon" data-bs-toggle="dropdown"
                                aria-expanded="false" title="Notifications">
                            <i class="bi bi-bell-fill"></i>
                            @if (ViewBag.UnreadNotifications > 0)
                            {
                                <span class="notification-badge">@ViewBag.UnreadNotifications</span>
                            }
                        </button>
                        <div class="dropdown-menu notification-dropdown p-0">
                            <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
                                <strong style="font-size:14px">Notifications</strong>
                                <form method="post" asp-action="MarkAllRead" asp-controller="Notifications">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link btn-sm p-0 text-muted" style="font-size:12px">Mark all read</button>
                                </form>
                            </div>
                            <div id="notification-list">
                                <div class="text-center p-4 text-muted">
                                    <i class="bi bi-arrow-clockwise d-block mb-1"></i>Click to load
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- User Avatar / Profile Dropdown -->
                    <div class="dropdown">
                        <div class="user-avatar" data-bs-toggle="dropdown" aria-expanded="false"
                             title="@currentUser?.FullName">
                            @userInitials
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end" style="border-radius:var(--radius-md);border-color:var(--border-color);background:var(--bg-card);min-width:200px;">
                            <li class="px-3 py-2 border-bottom">
                                <div style="font-weight:700;font-size:14px;color:var(--text-primary)">@currentUser?.FullName</div>
                                <div style="font-size:12px;color:var(--text-muted)">@currentUser?.Email</div>
                            </li>
                            <li>
                                <a class="dropdown-item" href="@Url.Action("Index","Profile")">
                                    <i class="bi bi-person me-2"></i>Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="@Url.Action("ChangePassword","Profile")">
                                    <i class="bi bi-shield-lock me-2"></i>Change Password
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-action="Logout" asp-controller="Account">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="page-content">
                <!-- Flash Messages -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible alert-auto-dismiss mb-4 d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@TempData["Success"]</span>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible alert-auto-dismiss mb-4 d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@TempData["Error"]</span>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info alert-dismissible alert-auto-dismiss mb-4 d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>@TempData["Info"]</span>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <div class="mesh-bg-container">
        <div class="mesh-blob mesh-blob-1"></div>
        <div class="mesh-blob mesh-blob-2"></div>
        <div class="mesh-blob mesh-blob-3"></div>
    </div>
    @* Auth pages: no sidebar, full-page layout *@
    @RenderBody()
}

<!-- ── Delete Confirmation Modal (global) ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--bg-card);border-radius:var(--radius-lg);border:1px solid var(--border-color);">
            <div class="modal-header border-bottom" style="border-color:var(--border-color)!important;">
                <h5 class="modal-title fw-700" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="color:var(--text-secondary);">
                <p id="delete-confirm-msg">Are you sure you want to delete this item? This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirm-delete-btn" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<!-- App JS -->
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
