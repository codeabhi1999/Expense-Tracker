@model MyDailyExpenseTracker.ViewModels.TransactionViewModel
@{
    ViewData["Title"]     = "Transaction Details";
    ViewData["PageTitle"] = "Transaction Details";
}

<div class="page-header">
    <h1><i class="bi bi-receipt me-2"></i>Transaction Details</h1>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Edit", new { id = Model.TransactionId })" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <!-- Amount Hero -->
            <div class="p-4 text-center border-bottom"
                 style="background:@(Model.Type == "Expense" ? "rgba(239,68,68,.06)" : "rgba(34,197,94,.06)")">
                <div style="font-size:13px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px">
                    @Model.Type
                </div>
                <div class="@(Model.Type == "Expense" ? "amount-expense" : "amount-income")"
                     style="font-size:42px;font-weight:800">
                    @(Model.Type == "Expense" ? "−" : "+")₹@Model.Amount.ToString("N2")
                </div>
                <div style="color:var(--text-muted);font-size:14px;margin-top:4px">
                    @Model.TransactionDate.ToString("dd MMMM yyyy, dddd")
                </div>
            </div>

            <div class="card-body">
                <dl class="row" style="row-gap:16px">
                    <dt class="col-5" style="color:var(--text-muted);font-size:13px">Description</dt>
                    <dd class="col-7 fw-600">@Model.Description</dd>

                    <dt class="col-5" style="color:var(--text-muted);font-size:13px">Category</dt>
                    <dd class="col-7">
                        <span class="category-pill">@Model.CategoryName</span>
                    </dd>

                    <dt class="col-5" style="color:var(--text-muted);font-size:13px">Payment Method</dt>
                    <dd class="col-7 fw-500">@(Model.PaymentMethodName ?? "—")</dd>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <dt class="col-5" style="color:var(--text-muted);font-size:13px">Notes</dt>
                        <dd class="col-7" style="color:var(--text-secondary)">@Model.Notes</dd>
                    }

                    <dt class="col-5" style="color:var(--text-muted);font-size:13px">Created</dt>
                    <dd class="col-7 text-muted-custom" style="font-size:13px">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>

                    <dt class="col-5" style="color:var(--text-muted);font-size:13px">Last Updated</dt>
                    <dd class="col-7 text-muted-custom" style="font-size:13px">@Model.UpdatedDate.ToString("dd MMM yyyy HH:mm")</dd>
                </dl>
            </div>

            <div class="card-body border-top d-flex gap-2">
                <a href="@Url.Action("Edit", new { id = Model.TransactionId })" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-pencil me-2"></i>Edit Transaction
                </a>
                <button type="button" class="btn btn-outline-danger"
                        data-delete-form="del-@Model.TransactionId"
                        data-delete-label="@Model.Description">
                    <i class="bi bi-trash"></i>
                </button>
                <form id="del-@Model.TransactionId" method="post"
                      asp-action="Delete" asp-route-id="@Model.TransactionId">
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>
    </div>
</div>
